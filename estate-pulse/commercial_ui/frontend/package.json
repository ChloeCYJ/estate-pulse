{
  "name": "estate-pulse-commercial-ui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "clean": "rimraf .\\build .\\dist",
    "prepare-build": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\prepare-build.ps1",
    "dev": "npm run prepare-build && vite build --watch --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "build": "npm run typecheck && npm run prepare-build && vite build --configLoader runner",
    "visual:search-home": "node .\\scripts\\capture-search-home.mjs"
  },
  "dependencies": {
    "@streamlit/component-v2-lib": "0.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.7.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "playwright": "^1.54.2",
    "rimraf": "6.0.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.0.6",
    "vitest": "3.2.4"
  }
}
